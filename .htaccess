# === zofiasiek: static front end in ROOT (WordPress front end off, admin remains) ===
ErrorDocument 404 /404.html

# Apache fallback. If Plesk serves static files directly through Nginx, .htaccess
# is bypassed; mirror the MIME/cache policy in "Additional nginx directives".
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:html?)$">
    Header set Cache-Control "no-cache"
    Header merge Vary "Accept-Encoding"
  </FilesMatch>

  <FilesMatch "\.(?:css|js|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header merge Vary "Accept-Encoding"
  </FilesMatch>

  <FilesMatch "\.(?:avif|webp|png|jpe?g|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  <FilesMatch "^(?:logo-526x200-v1|slide-[0-9]{2}-[0-9]+w-v1|.+-800x1000-v1)\.(?:png|avif|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Keep one canonical host and preserve the requested path and query string.
  RewriteCond %{HTTP_HOST} ^www\.zofiasiek\.pl$ [NC]
  RewriteRule ^ https://zofiasiek.pl%{REQUEST_URI} [R=301,L,NE]

  # Consolidated byte-identical image files. Keep legacy URLs working for
  # search engines, external links and visitors with an older cached page.
  RewriteRule ^img/realizacje/dama-z-lasiczka-leonardo-da-vinci\.jpg$ /img/kopie/dama-z-gronostajem-leonardo-da-vinci/00.jpg [R=301,L,NE]
  RewriteRule ^img/realizacje/dziewczyna-z-perla\.jpg$ /img/kopie/dziewczyna-z-perla-johannes-vermeer/00.jpg [R=301,L,NE]
  RewriteRule ^img/realizacje/krzyk-edward-munch\.jpg$ /img/kopie/krzyk-edvard-munch/04.jpg [R=301,L,NE]
  RewriteRule ^img/realizacje/matka-boska-wspomozenia-wiernych-cranach\.jpg$ /img/kopie/matka-boska-wspomozenia-wiernych-lucas-cranach/00.jpg [R=301,L,NE]
  RewriteRule ^img/realizacje/paysage-de-juan-les-pins-pablo-picasso\.jpg$ /img/kopie/pablo-picasso-pejzaz-z-lodkami/02.jpg [R=301,L,NE]
  RewriteRule ^img/realizacje/pocalunek-gustav-klimt\.jpg$ /img/kopie/pocalunek-gustav-klimt/00.jpg [R=301,L,NE]
  RewriteRule ^img/realizacje/portret-malzonkow-arnolfinich-jan-van-eyck\.jpg$ /img/kopie/portret-malzonkow-arnolfinich-jan-van-eyck/00.jpg [R=301,L,NE]
  RewriteRule ^img/realizacje/szal-uniesien-wladyslaw-podkowinski\.jpg$ /img/kopie/szal-uniesien-wladyslaw-podkowinski/00.jpg [R=301,L,NE]
  RewriteRule ^img/kopie/paysage-de-juan-les-pins-pablo-picasso/00\.jpg$ /img/kopie/pablo-picasso-pejzaz-z-lodkami/02.jpg [R=301,L,NE]
  RewriteRule ^img/kopie/paysage-de-juan-les-pins-pablo-picasso/01\.jpg$ /img/kopie/pablo-picasso-pejzaz-z-lodkami/03.jpg [R=301,L,NE]
  RewriteRule ^img/kopie/paysage-de-juan-les-pins-pablo-picasso/03\.jpg$ /img/kopie/pablo-picasso-pejzaz-z-lodkami/05.jpg [R=301,L,NE]
  RewriteRule ^img/kopie/pablo-picasso-pejzaz-z-lodkami/04\.jpg$ /img/kopie/pablo-picasso-pejzaz-z-lodkami/03.jpg [R=301,L,NE]

  # Keep the WordPress administration and service endpoints available.
  RewriteRule ^(wp-admin|wp-includes|wp-content|wp-json|wp-login\.php|wp-cron\.php|xmlrpc\.php) - [L]

  # Known pages moved from the previous WordPress website.
  RewriteRule ^konserwacja-zabytkow-i-dziel-sztuki(?:/index\.html)?/?$ https://zofiasiek.pl/konserwacja/ [R=301,L,NE]
  RewriteRule ^konserwacja-obrazu(?:/index\.html)?/?$ https://zofiasiek.pl/konserwacja/ [R=301,L,NE]
  RewriteRule ^konserwacja-obrazu/feed(?:/index\.html)?/?$ https://zofiasiek.pl/konserwacja/ [R=301,L,NE]
  RewriteRule ^stol-dublazowy(?:/index\.html)?/?$ https://zofiasiek.pl/konserwacja/ [R=301,L,NE]
  RewriteRule ^portret-malzonkow-arnolfinich-jana-van-eycka(?:/index\.html)?/?$ https://zofiasiek.pl/kopie-obrazow/portret-malzonkow-arnolfinich/ [R=301,L,NE]
  RewriteRule ^vermeer-dziewczyna-z-perla(?:/index\.html)?/?$ https://zofiasiek.pl/kopie-obrazow/dziewczyna-z-perla/ [R=301,L,NE]

  # Painting detail URLs localized after the first multilingual release.
  RewriteRule ^en/painting-copies/dama-z-gronostajem(?:/index\.html)?/?$ https://zofiasiek.pl/en/painting-copies/lady-with-an-ermine/ [R=301,L,NE]
  RewriteRule ^en/painting-copies/druhny-krasnowolski(?:/index\.html)?/?$ https://zofiasiek.pl/en/painting-copies/bridesmaids-krasnowolski/ [R=301,L,NE]
  RewriteRule ^en/painting-copies/dziewczyna-z-perla(?:/index\.html)?/?$ https://zofiasiek.pl/en/painting-copies/girl-with-a-pearl-earring/ [R=301,L,NE]
  RewriteRule ^en/painting-copies/gwiazdzista-noc-van-gogh(?:/index\.html)?/?$ https://zofiasiek.pl/en/painting-copies/the-starry-night-van-gogh/ [R=301,L,NE]
  RewriteRule ^en/painting-copies/kosciol-w-cassone-klimt(?:/index\.html)?/?$ https://zofiasiek.pl/en/painting-copies/church-in-cassone-klimt/ [R=301,L,NE]
  RewriteRule ^en/painting-copies/krzyk-munch(?:/index\.html)?/?$ https://zofiasiek.pl/en/painting-copies/the-scream-munch/ [R=301,L,NE]
  RewriteRule ^en/painting-copies/matka-boska-wspomozenia-wiernych-cranach(?:/index\.html)?/?$ https://zofiasiek.pl/en/painting-copies/mary-help-of-christians-cranach/ [R=301,L,NE]
  RewriteRule ^en/painting-copies/pasja-turynska-memling(?:/index\.html)?/?$ https://zofiasiek.pl/en/painting-copies/scenes-from-the-passion-of-christ-memling/ [R=301,L,NE]
  RewriteRule ^en/painting-copies/pejzaz-z-lodkami-picasso(?:/index\.html)?/?$ https://zofiasiek.pl/en/painting-copies/landscape-at-juan-les-pins-picasso/ [R=301,L,NE]
  RewriteRule ^en/painting-copies/pocalunek-klimt(?:/index\.html)?/?$ https://zofiasiek.pl/en/painting-copies/the-kiss-klimt/ [R=301,L,NE]
  RewriteRule ^en/painting-copies/portret-malzonkow-arnolfinich(?:/index\.html)?/?$ https://zofiasiek.pl/en/painting-copies/the-arnolfini-portrait/ [R=301,L,NE]
  RewriteRule ^en/painting-copies/szal-uniesien-podkowinski(?:/index\.html)?/?$ https://zofiasiek.pl/en/painting-copies/frenzy-of-exultations-podkowinski/ [R=301,L,NE]
  RewriteRule ^en/painting-copies/widok-na-kopiec-kosciuszki-wyspianski(?:/index\.html)?/?$ https://zofiasiek.pl/en/painting-copies/view-of-the-kosciuszko-mound-in-krakow-wyspianski/ [R=301,L,NE]
  RewriteRule ^de/gemaeldekopien/dama-z-gronostajem(?:/index\.html)?/?$ https://zofiasiek.pl/de/gemaeldekopien/dame-mit-dem-hermelin/ [R=301,L,NE]
  RewriteRule ^de/gemaeldekopien/druhny-krasnowolski(?:/index\.html)?/?$ https://zofiasiek.pl/de/gemaeldekopien/brautjungfern-krasnowolski/ [R=301,L,NE]
  RewriteRule ^de/gemaeldekopien/dziewczyna-z-perla(?:/index\.html)?/?$ https://zofiasiek.pl/de/gemaeldekopien/maedchen-mit-dem-perlenohrring/ [R=301,L,NE]
  RewriteRule ^de/gemaeldekopien/gwiazdzista-noc-van-gogh(?:/index\.html)?/?$ https://zofiasiek.pl/de/gemaeldekopien/sternennacht-van-gogh/ [R=301,L,NE]
  RewriteRule ^de/gemaeldekopien/kosciol-w-cassone-klimt(?:/index\.html)?/?$ https://zofiasiek.pl/de/gemaeldekopien/kirche-in-cassone-klimt/ [R=301,L,NE]
  RewriteRule ^de/gemaeldekopien/krzyk-munch(?:/index\.html)?/?$ https://zofiasiek.pl/de/gemaeldekopien/schrei-munch/ [R=301,L,NE]
  RewriteRule ^de/gemaeldekopien/matka-boska-wspomozenia-wiernych-cranach(?:/index\.html)?/?$ https://zofiasiek.pl/de/gemaeldekopien/mariahilf-cranach/ [R=301,L,NE]
  RewriteRule ^de/gemaeldekopien/pasja-turynska-memling(?:/index\.html)?/?$ https://zofiasiek.pl/de/gemaeldekopien/turiner-passion-memling/ [R=301,L,NE]
  RewriteRule ^de/gemaeldekopien/pejzaz-z-lodkami-picasso(?:/index\.html)?/?$ https://zofiasiek.pl/de/gemaeldekopien/landschaft-bei-juan-les-pins-picasso/ [R=301,L,NE]
  RewriteRule ^de/gemaeldekopien/pocalunek-klimt(?:/index\.html)?/?$ https://zofiasiek.pl/de/gemaeldekopien/kuss-klimt/ [R=301,L,NE]
  RewriteRule ^de/gemaeldekopien/portret-malzonkow-arnolfinich(?:/index\.html)?/?$ https://zofiasiek.pl/de/gemaeldekopien/arnolfini-hochzeit/ [R=301,L,NE]
  RewriteRule ^de/gemaeldekopien/szal-uniesien-podkowinski(?:/index\.html)?/?$ https://zofiasiek.pl/de/gemaeldekopien/ekstase-podkowinski/ [R=301,L,NE]
  RewriteRule ^de/gemaeldekopien/widok-na-kopiec-kosciuszki-wyspianski(?:/index\.html)?/?$ https://zofiasiek.pl/de/gemaeldekopien/blick-auf-den-kosciuszko-huegel-wyspianski/ [R=301,L,NE]

  # Normalise explicit root index.html and root-level flat .html URLs.
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteCond %{REQUEST_URI} !^/404\.html$
  RewriteCond %{REQUEST_URI} ^/([^/]+)\.html$
  RewriteRule ^ /%1/ [R=301,L]
</IfModule>

DirectoryIndex index.html index.php
